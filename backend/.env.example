PORT=4000
NODE_ENV=development
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8081

# Dokploy (set in Environment tab — do NOT commit real secrets)
# NIXPACKS_NODE_VERSION=22
# NIXPACKS_BUILD_CMD=npm run build
# NIXPACKS_START_CMD=npm start
# Required: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ANON_KEY
# Required: RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET
# Domain tab: api.yourdomain.com → container port 4000
# Do NOT set API_URL here — that is for Next.js SSR only, not this service.

# Supabase — pick region closest to users (India: ap-south-1 Mumbai)
SUPABASE_URL=https://asd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sdf
SUPABASE_ANON_KEY=asd

# Optional CDN for storage images (Cloudflare proxy → Supabase public storage path)
# Example: https://cdn.yourdomain.com  (must mirror /storage/v1/object/public/... paths)
# STORAGE_CDN_URL=https://cdn.yourdomain.com

# Razorpay
# Use rzp_live_* keys for production, rzp_test_* for sandbox
RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Google Gemini (product image + copy generation)
GOOGLE_GEMINI_API_KEY=AIza-xxxx
# Optional model overrides
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# AI_SOURCE_MAX_EDGE=1024

# Super admin account (CLI only — never commit real values)
# SUPERADMIN_EMAIL=sbox-platform-admin@yourdomain.com
# SUPERADMIN_PASSWORD=your-strong-password-min-16-chars
# SUPERADMIN_NAME=S-Box Platform Admin

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ADMIN_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# Shiprocket (logistics — use API user email/password from Shiprocket Settings > API)
SHIPROCKET_EMAIL=your_api_user@example.com
SHIPROCKET_PASSWORD=your_api_user_password
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=560001
SHIPROCKET_WEBHOOK_TOKEN=generate_a_random_secret_string
# Auto-create a shipment after payment is verified. Set to "false" to disable
# and create shipments manually from the admin dashboard.
SHIPROCKET_AUTO_CREATE=true
# Courier auto-selection strategy: cheapest | fastest | rating
SHIPROCKET_COURIER_STRATEGY=cheapest
# Max retries for transient Shiprocket API errors (429/5xx/network)
SHIPROCKET_RETRY_MAX=3
