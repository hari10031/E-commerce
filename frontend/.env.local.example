NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side only — loopback on same host (production: http://127.0.0.1:4000)
API_URL=http://127.0.0.1:4000
# Optional — same host as backend STORAGE_CDN_URL (for next/image remotePatterns)
# NEXT_PUBLIC_STORAGE_CDN_URL=https://cdn.yourdomain.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Must match backend RAZORPAY_KEY_ID (rzp_live_* for production)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxx
